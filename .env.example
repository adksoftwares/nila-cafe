# ==============================================================================
# Nila Cafe — production environment template
# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# ==============================================================================

# --- Database ---
POSTGRES_DB=nila_cafe_db
POSTGRES_USER=nila_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- API auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_chars_random
LOG_LEVEL=info

# --- Browser origins allowed to call the API (comma-separated, exact match) ---
# Web: the URL the browser opens, e.g. https://pos.example.com
# Mobile app (Capacitor): add https://localhost and capacitor://localhost
CLIENT_ORIGIN=https://pos.example.com

# --- Public API URL baked into the web/mobile build ---
VITE_API_URL=https://api.example.com/api
