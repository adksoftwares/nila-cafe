# ==============================================================================
# Nila Cafe — Unified Environment Configuration Template
# ==============================================================================

# --- Node & API Server Configuration ---
PORT=4000
NODE_ENV=production
APP_VERSION=1.0.0

# --- Database Connection Pool ---
# PostgreSQL 16+ connection URI with credentials and target database
DATABASE_URL=postgresql://nila_user:nila_secure_password@localhost:5432/nila_cafe_db

# --- Security & JWT Authentication ---
# CRITICAL: Replace with a cryptographically random secret in production (>= 32 chars)
# E.g., generate using: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-secret-in-production-min-32-chars

# --- CORS & Security Headers ---
# Comma-separated list of allowed web origins
CLIENT_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

# --- Structured Logging Level ---
# Options: debug | info | warn | error | silent
LOG_LEVEL=info

# --- Client Frontend Configuration (Vite) ---
# Base URL for backend REST API endpoints
VITE_API_URL=http://localhost:4000/api
